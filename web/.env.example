# Copy this file to .env.local and fill in the values. Never commit .env.local.

# MySQL (use the limited gym_app user, not root)
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=gym_app
MYSQL_PASSWORD=
MYSQL_DATABASE=gym_management

# MongoDB
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=gym_management_docs

# Long random text used to hash one-time passwords (any 30+ characters)
APP_SECRET=

# Demo: show SMS / email codes on screen because no SMS or email gateway is connected
DEMO_SHOW_OTP=true

# Phone access during the QR demo: the laptop's Wi-Fi address, e.g. 192.168.1.20 (comma separated)
ALLOWED_DEV_ORIGINS=
